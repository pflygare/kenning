# Copy to backend/.env (or export these) before running the backend.
# The user must be able to create databases for `cargo test` (the Compose user can).
DATABASE_URL=postgres://kenning:kenning@127.0.0.1:5432/kenning
# DATABASE_MAX_CONNECTIONS=10
# BIND_ADDR=127.0.0.1
# PORT=3000
# Serve the built frontend from the backend (production):
# STATIC_DIR=../frontend/dist
# RUST_LOG=kenning_server=debug,tower_http=info
