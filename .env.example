# Copy to backend/.env (or export these) before running the backend.
# The user must be able to create databases for `cargo test` (the Compose user can).
DATABASE_URL=postgres://kenning:kenning@127.0.0.1:5432/kenning
# DATABASE_MAX_CONNECTIONS=10
# BIND_ADDR=127.0.0.1
# PORT=3000
# Serve the built frontend from the backend (production):
# STATIC_DIR=../frontend/dist
# RUST_LOG=kenning_server=debug,tower_http=info

# Where people reach Kenning; used in emailed links and the Google redirect.
# With the Vite dev server, use http://localhost:5173. An https URL makes the
# session cookie Secure.
# PUBLIC_URL=http://localhost:3000

# Google sign-in. Create an OAuth client (type "Web application") in Google
# Cloud and add {PUBLIC_URL}/api/auth/google/callback as a redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Outgoing email. Without SMTP_URL, emails are written to the server log.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Kenning <no-reply@example.com>
